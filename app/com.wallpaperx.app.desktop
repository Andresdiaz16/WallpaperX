[Desktop Entry]
Type=Application
Name=WallpaperX
GenericName=Wallpaper Manager
Comment=Interactive wallpapers for Linux
Exec=wallpaperx %F
Icon=preferences-desktop-wallpaper
MimeType=application/x-wallpaperx;
Terminal=false
Categories=Qt;KDE;Settings;DesktopSettings;
Keywords=wallpaper;background;desktop;shader;video;
StartupNotify=true
StartupWMClass=wallpaperx
X-KDE-StartupNotify=true
