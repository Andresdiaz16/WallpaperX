<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<!-- The bus app_kscreen_launcher runs on: renderer/tests/support/isolated_session.conf, included
     below, plus one service directory, which app/tests/CMakeLists.txt fills with the test's own
     io.wallpaperx.test.Launcher.* stand-ins and nothing else. No standard service directory, so the
     real KScreen launcher cannot start. No <listen>: private_bus.sh adds one inside the entry's
     private runtime directory. -->
<busconfig>
  <servicedir>@WALLPAPERX_APP_TEST_SERVICE_DIR_XML@</servicedir>
  <include>@WALLPAPERX_ISOLATED_SESSION_CONF_XML@</include>
</busconfig>
